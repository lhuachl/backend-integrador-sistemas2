# FlowState API — environment variables
# Copiar a .env y completar

PORT=8080
DATABASE_URL=postgresql://postgres:xxxxxxxx@host:5432/insforge?sslmode=require
JWT_SECRET=change-me-in-production
ACCESS_TTL=15m
REFRESH_TTL=168h
GOOGLE_CLIENT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
ENV=dev
