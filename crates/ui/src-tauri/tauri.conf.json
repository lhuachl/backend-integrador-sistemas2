{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flowstate",
  "version": "0.1.0",
  "identifier": "com.flowstate.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "dx serve --platform mobile",
    "beforeBuildCommand": "dx build --platform mobile"
  },
  "app": {
    "windows": [
      {
        "title": "FlowState",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": ["flowstate"]
    }
  }
}
