{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "deep-link:allow-get-current",
    "deep-link:allow-register",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save"
  ]
}
